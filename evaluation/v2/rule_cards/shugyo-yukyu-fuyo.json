{
  "format": "rule-card@1",
  "id": "shugyo-yukyu-fuyo",
  "status": "draft",
  "drafted_by": "claude-opus-5-5（2026-11-02・規程の文だけから下書き）",
  "confirmed_by": null,
  "doc": {
    "source": "general/就業規則.md",
    "section": "年次有給休暇",
    "quote": "会社は、雇入れの日から起算して勤続6ヶ月を経過し、かつ、その間の全労働日の8割以上出勤した従業員に対して、10日の年次有給休暇を付与する。"
  },
  "target": "年次有給休暇の付与",
  "match": {
    "conclusions": [
      "付与される",
      "付与されない"
    ],
    "keywords": [
      "有給休暇"
    ]
  },
  "slots": {
    "勤続月数": {
      "type": "number",
      "unit": "か月",
      "describe": "雇入れの日（入社）から経過した期間"
    },
    "出勤日数": {
      "type": "number",
      "unit": "日",
      "describe": "その期間に実際に出勤した日数"
    },
    "全労働日数": {
      "type": "number",
      "unit": "日",
      "describe": "その期間の全労働日の日数"
    },
    "欠勤日数": {
      "type": "number",
      "unit": "日",
      "describe": "その期間に欠勤した日数"
    }
  },
  "derive": {
    "出勤日数": {
      "sub": [
        "全労働日数",
        "欠勤日数"
      ]
    }
  },
  "constraints": [
    {
      "name": "出勤日数は全労働日数以下",
      "left": "出勤日数",
      "op": "<=",
      "right": "全労働日数"
    },
    {
      "name": "全労働日数は 0 より大きい",
      "left": "全労働日数",
      "op": ">",
      "right": 0
    }
  ],
  "conditions": [
    {
      "name": "勤続6ヶ月を経過した",
      "left": "勤続月数",
      "op": ">=",
      "right": 6
    },
    {
      "name": "全労働日の8割以上出勤した",
      "left": {
        "div": [
          "出勤日数",
          "全労働日数"
        ]
      },
      "op": ">=",
      "right": 0.8
    }
  ],
  "combine": "all",
  "conclusion": {
    "then": "付与される",
    "else": "付与されない"
  }
}
