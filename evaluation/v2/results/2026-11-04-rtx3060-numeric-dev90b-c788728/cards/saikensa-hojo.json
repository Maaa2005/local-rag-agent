{
  "format": "rule-card@1",
  "id": "saikensa-hojo",
  "status": "draft",
  "drafted_by": "claude-fable-5-1",
  "confirmed_by": null,
  "doc": {
    "source": "再検査費補助規程",
    "section": "第2条・第3条",
    "quote": "結果通知書の日付の翌日から数えて30日以内に再検査を受診した場合に、再検査費用の全額を補助する。"
  },
  "target": "再検査費用の補助",
  "match": {
    "conclusions": [
      "補助可",
      "補助不可"
    ],
    "keywords": [
      "再検査"
    ]
  },
  "slots": {
    "要再検査判定": {
      "type": "bool",
      "describe": "定期健康診断で「要再検査」と判定されたか"
    },
    "自己判断の追加検査": {
      "type": "bool",
      "describe": "自分の判断で受けた追加の検査か"
    },
    "結果通知書の日付": {
      "type": "date",
      "describe": "結果通知書の日付"
    },
    "受診日": {
      "type": "date",
      "describe": "再検査を受診した日"
    },
    "申請額": {
      "type": "number",
      "unit": "円",
      "describe": "補助を求める金額"
    },
    "再検査費用": {
      "type": "number",
      "unit": "円",
      "describe": "再検査にかかった費用"
    }
  },
  "conditions": [
    {
      "name": "定期健康診断で「要再検査」と判定された",
      "left": "要再検査判定",
      "op": "==",
      "right": "あり",
      "quote": "補助の対象は、定期健康診断で「要再検査」と判定された社員に限る。"
    },
    {
      "name": "結果通知書の日付の翌日から数えて30日以内に受診した",
      "left": "受診日",
      "op": "<=",
      "right": {
        "add_days": [
          "結果通知書の日付",
          30
        ]
      },
      "quote": "結果通知書の日付の翌日から数えて30日以内に再検査を受診した場合に、再検査費用の全額を補助する。"
    },
    {
      "name": "申請額が再検査費用と1万円の小さい方以下",
      "left": "申請額",
      "op": "<=",
      "right": {
        "min": [
          "再検査費用",
          10000
        ]
      },
      "quote": "1回につき1万円を上限とする。"
    }
  ],
  "combine": "all",
  "exceptions": [
    {
      "name": "自分の判断で受けた追加の検査は対象としない",
      "left": "自己判断の追加検査",
      "op": "==",
      "right": "あり",
      "conclusion": "補助不可",
      "if_unknown": "hold",
      "quote": "自分の判断で受けた追加の検査は、対象としない。"
    }
  ],
  "conclusion": {
    "then": "補助可",
    "else": "補助不可"
  }
}
