{
  "format": "rule-card@1",
  "id": "zaitaku-teate-shikyu",
  "status": "draft",
  "drafted_by": "claude-fable-5-1",
  "confirmed_by": null,
  "doc": {
    "source": "在宅勤務手当規程",
    "section": "第2条・第3条・第4条・第5条",
    "quote": "在宅勤務日が1か月に5日以上ある月に、手当を支給する。"
  },
  "target": "在宅勤務手当の支給",
  "match": {
    "conclusions": [
      "支給",
      "見送り"
    ],
    "keywords": [
      "在宅勤務"
    ]
  },
  "slots": {
    "正社員か": {
      "type": "bool",
      "describe": "正社員か"
    },
    "利用登録を済ませたか": {
      "type": "bool",
      "describe": "在宅勤務制度の利用登録を済ませたか"
    },
    "1日の在宅勤務時間": {
      "type": "number",
      "unit": "時間",
      "describe": "在宅で勤務した時間（1日あたり）"
    },
    "1日の在宅勤務分数": {
      "type": "number",
      "unit": "分",
      "describe": "在宅で勤務した時間（1日あたり、分）"
    },
    "在宅勤務日数": {
      "type": "number",
      "unit": "日",
      "describe": "1か月の在宅勤務日の日数"
    },
    "申告実費額": {
      "type": "number",
      "unit": "円",
      "describe": "在宅勤務に使った通信費・光熱費として申告した実費額"
    },
    "短時間勤務か": {
      "type": "bool",
      "describe": "育児又は介護のために短時間勤務制度を使っているか"
    }
  },
  "derive": {
    "1日の在宅勤務分数": {
      "mul": [
        "1日の在宅勤務時間",
        60
      ]
    }
  },
  "constraints": [
    {
      "name": "在宅勤務日数は 0 以上",
      "left": "在宅勤務日数",
      "op": ">=",
      "right": 0
    },
    {
      "name": "申告実費額は 0 以上",
      "left": "申告実費額",
      "op": ">=",
      "right": 0
    }
  ],
  "conditions": [
    {
      "name": "正社員である",
      "left": "正社員か",
      "op": "==",
      "right": "あり",
      "quote": "手当の対象は、在宅勤務制度の利用登録を済ませた正社員に限る。"
    },
    {
      "name": "在宅勤務制度の利用登録を済ませた",
      "left": "利用登録を済ませたか",
      "op": "==",
      "right": "あり",
      "quote": "手当の対象は、在宅勤務制度の利用登録を済ませた正社員に限る。"
    },
    {
      "name": "在宅で勤務した時間が1日に4時間以上（短時間勤務は3時間以上）",
      "any": [
        {
          "name": "短時間勤務でなく、1日に240分以上",
          "all": [
            {
              "name": "短時間勤務制度を使っていない",
              "left": "短時間勤務か",
              "op": "==",
              "right": "なし"
            },
            {
              "name": "在宅で勤務した時間が1日に240分以上",
              "left": "1日の在宅勤務分数",
              "op": ">=",
              "right": 240
            }
          ],
          "quote": "在宅で勤務した時間が1日に4時間以上（240分以上）である日を、在宅勤務日と数える。"
        },
        {
          "name": "短時間勤務で、1日に180分以上",
          "all": [
            {
              "name": "短時間勤務制度を使っている",
              "left": "短時間勤務か",
              "op": "==",
              "right": "あり"
            },
            {
              "name": "在宅で勤務した時間が1日に180分以上",
              "left": "1日の在宅勤務分数",
              "op": ">=",
              "right": 180
            }
          ],
          "quote": "ただし、育児又は介護のために短時間勤務制度を使っている社員については、第3条第1項の「4時間以上（240分以上）」を「3時間以上（180分以上）」と読み替える。"
        }
      ],
      "quote": "在宅で勤務した時間が1日に4時間以上（240分以上）である日を、在宅勤務日と数える。"
    },
    {
      "name": "在宅勤務日が1か月に5日以上",
      "left": "在宅勤務日数",
      "op": ">=",
      "right": 5,
      "quote": "在宅勤務日が1か月に5日以上ある月に、手当を支給する。"
    },
    {
      "name": "手当額（実費額の70%と在宅勤務日数×400円の小さい方）が1,000円以上",
      "left": {
        "min": [
          {
            "mul": [
              "申告実費額",
              0.7
            ]
          },
          {
            "mul": [
              "在宅勤務日数",
              400
            ]
          }
        ]
      },
      "op": ">=",
      "right": 1000,
      "quote": "前項により算出した手当額が1,000円に満たないときは、手当を支給しない。"
    }
  ],
  "combine": "all",
  "conclusion": {
    "then": "支給",
    "else": "見送り"
  }
}
