{
  "format": "rule-card@1",
  "id": "saikensa-shinsei-kigen",
  "status": "draft",
  "drafted_by": "claude-fable-5-1",
  "confirmed_by": null,
  "doc": {
    "source": "再検査費補助規程",
    "section": "第4条・第5条",
    "quote": "補助の申請は、再検査を受診した月の翌月の末日までに行う。"
  },
  "target": "再検査費補助の申請の期限",
  "match": {
    "conclusions": [
      "受理",
      "却下"
    ],
    "keywords": [
      "再検査",
      "申請"
    ]
  },
  "slots": {
    "受診日": {
      "type": "date",
      "describe": "再検査を受診した日"
    },
    "受診年": {
      "type": "number",
      "unit": "年",
      "describe": "再検査を受診した年"
    },
    "受診月": {
      "type": "number",
      "unit": "月",
      "describe": "再検査を受診した月"
    },
    "申請日": {
      "type": "date",
      "describe": "補助の申請をした日"
    }
  },
  "constraints": [
    {
      "name": "受診月は 1 以上",
      "left": "受診月",
      "op": ">=",
      "right": 1
    },
    {
      "name": "受診月は 12 以下",
      "left": "受診月",
      "op": "<=",
      "right": 12
    }
  ],
  "conditions": [
    {
      "name": "申請期限までに申請した",
      "any": [
        {
          "name": "3月に受診し、同年の3月31日までに申請した",
          "all": [
            {
              "name": "3月に受診した",
              "left": "受診月",
              "op": "==",
              "right": 3
            },
            {
              "name": "同年の3月31日までに申請した",
              "left": "申請日",
              "op": "<=",
              "right": {
                "month_day": [
                  "受診年",
                  3,
                  31
                ]
              }
            }
          ],
          "quote": "ただし、3月に受診した場合の申請期限は、年度末の経理締めのため、同年の3月31日とする。"
        },
        {
          "name": "3月以外に受診し、受診した月の翌月の末日までに申請した",
          "all": [
            {
              "name": "3月以外に受診した",
              "any": [
                {
                  "name": "受診月が3より前",
                  "left": "受診月",
                  "op": "<",
                  "right": 3
                },
                {
                  "name": "受診月が3より後",
                  "left": "受診月",
                  "op": ">",
                  "right": 3
                }
              ]
            },
            {
              "name": "受診した月の翌月の末日までに申請した",
              "left": "申請日",
              "op": "<=",
              "right": {
                "month_end": {
                  "add_months": [
                    "受診日",
                    1
                  ]
                }
              }
            }
          ],
          "quote": "補助の申請は、再検査を受診した月の翌月の末日までに行う。"
        }
      ],
      "quote": "補助の申請は、再検査を受診した月の翌月の末日までに行う。"
    }
  ],
  "combine": "all",
  "conclusion": {
    "then": "受理",
    "else": "却下"
  }
}
