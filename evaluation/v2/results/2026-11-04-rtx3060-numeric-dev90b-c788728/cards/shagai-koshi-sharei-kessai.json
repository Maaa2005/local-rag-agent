{
  "format": "rule-card@1",
  "id": "shagai-koshi-sharei-kessai",
  "status": "draft",
  "drafted_by": "claude-fable-5-1",
  "confirmed_by": null,
  "doc": {
    "source": "社外講師謝礼規程",
    "section": "第3条・第4条・第5条・第6条",
    "quote": "謝礼額が3万円を超えるときは、総務部長の決裁を要する。"
  },
  "target": "社外講師の謝礼の総務部長の決裁",
  "match": {
    "conclusions": [
      "必要",
      "不要"
    ],
    "keywords": [
      "謝礼",
      "講師"
    ]
  },
  "slots": {
    "講義分数": {
      "type": "number",
      "unit": "分",
      "describe": "講義時間（分）"
    },
    "講義時間数": {
      "type": "number",
      "unit": "時間",
      "describe": "講義時間（時間）"
    },
    "予算額": {
      "type": "number",
      "unit": "円",
      "describe": "その講義に割り当てられた予算額"
    },
    "謝礼額": {
      "type": "number",
      "unit": "円",
      "describe": "謝礼額（講義時間に1時間あたり1万円を乗じた額と予算額のうち小さい方）"
    },
    "年度内既払い額": {
      "type": "number",
      "unit": "円",
      "describe": "同一年度（4月1日から翌年3月31日まで）に同一の講師に既に支払った謝礼の累計（今回分を除く）"
    },
    "年度累計額": {
      "type": "number",
      "unit": "円",
      "describe": "同一年度（4月1日から翌年3月31日まで）に同一の講師に支払う謝礼の累計（今回分を含む）"
    },
    "元社員か": {
      "type": "bool",
      "describe": "元社員が講師を務めるか"
    },
    "退職日": {
      "type": "date",
      "describe": "元社員が退職した日"
    },
    "講義日": {
      "type": "date",
      "describe": "講義を行う日"
    }
  },
  "derive": {
    "講義分数": {
      "mul": [
        "講義時間数",
        60
      ]
    },
    "謝礼額": {
      "min": [
        {
          "div": [
            {
              "mul": [
                "講義分数",
                10000
              ]
            },
            60
          ]
        },
        "予算額"
      ]
    },
    "年度累計額": {
      "add": [
        "年度内既払い額",
        "謝礼額"
      ]
    }
  },
  "constraints": [
    {
      "name": "講義分数は 0 より大きい",
      "left": "講義分数",
      "op": ">",
      "right": 0
    },
    {
      "name": "年度内既払い額は 0 以上",
      "left": "年度内既払い額",
      "op": ">=",
      "right": 0
    }
  ],
  "conditions": [
    {
      "name": "謝礼額が3万円を超える",
      "left": "謝礼額",
      "op": ">",
      "right": 30000,
      "quote": "謝礼額が3万円を超えるときは、総務部長の決裁を要する。"
    },
    {
      "name": "同一年度の謝礼の累計が今回分を含めて10万円を超える",
      "left": "年度累計額",
      "op": ">",
      "right": 100000,
      "quote": "同一の講師に同一年度（4月1日から翌年3月31日まで）に支払う謝礼の累計が、今回分を含めて10万円を超えるときも、金額にかかわらず総務部長の決裁を要する。"
    },
    {
      "name": "退職後2年以内の元社員が講師を務める",
      "all": [
        {
          "name": "元社員が講師を務める",
          "left": "元社員か",
          "op": "==",
          "right": "あり"
        },
        {
          "name": "講義日が退職日から2年以内",
          "left": "講義日",
          "op": "<=",
          "right": {
            "add_months": [
              "退職日",
              24
            ]
          }
        }
      ],
      "quote": "ただし、退職後2年以内の元社員が講師を務める場合は、謝礼額にかかわらず総務部長の決裁を要する。"
    }
  ],
  "combine": "any",
  "conclusion": {
    "then": "必要",
    "else": "不要"
  }
}
