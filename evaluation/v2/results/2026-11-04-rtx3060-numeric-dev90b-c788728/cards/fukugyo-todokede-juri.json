{
  "format": "rule-card@1",
  "id": "fukugyo-todokede-juri",
  "status": "draft",
  "drafted_by": "claude-fable-5-1",
  "confirmed_by": null,
  "doc": {
    "source": "副業届出規程",
    "section": "第2条・第3条・第4条・第5条",
    "quote": "副業の届出を受理するのは、届出の時点で入社後6か月を経過した社員に限る。"
  },
  "target": "副業の届出の受理",
  "match": {
    "conclusions": [
      "受理",
      "却下"
    ],
    "keywords": [
      "副業"
    ]
  },
  "slots": {
    "入社後の月数": {
      "type": "number",
      "unit": "か月",
      "describe": "届出の時点で入社後に経過した月数"
    },
    "週の作業時間": {
      "type": "number",
      "unit": "時間",
      "describe": "副業の作業時間（1週間あたり）"
    },
    "週の作業分数": {
      "type": "number",
      "unit": "分",
      "describe": "副業の作業時間（1週間あたりの分）"
    },
    "繁忙期の開始": {
      "type": "bool",
      "describe": "副業の開始日が毎年12月1日から翌年1月10日までの間にあるか"
    },
    "開始日": {
      "type": "date",
      "describe": "副業の開始日"
    },
    "届出日": {
      "type": "date",
      "describe": "届出を出した日"
    },
    "開始日までの日数": {
      "type": "number",
      "unit": "日",
      "describe": "届出日から副業の開始日までの日数"
    }
  },
  "derive": {
    "週の作業時間": {
      "div": [
        "週の作業分数",
        60
      ]
    },
    "開始日までの日数": {
      "sub": [
        "開始日",
        "届出日"
      ]
    }
  },
  "constraints": [
    {
      "name": "週の作業時間は 0 以上",
      "left": "週の作業時間",
      "op": ">=",
      "right": 0
    }
  ],
  "conditions": [
    {
      "name": "届出の時点で入社後6か月を経過した",
      "left": "入社後の月数",
      "op": ">=",
      "right": 6,
      "quote": "副業の届出を受理するのは、届出の時点で入社後6か月を経過した社員に限る。"
    },
    {
      "name": "作業時間が1週間あたりの上限以内",
      "any": [
        {
          "name": "繁忙期の開始でなく、1週間あたり12時間以内",
          "all": [
            {
              "name": "開始日が12月1日から翌年1月10日までの間にない",
              "left": "繁忙期の開始",
              "op": "==",
              "right": "なし"
            },
            {
              "name": "1週間あたり12時間以内",
              "left": "週の作業時間",
              "op": "<=",
              "right": 12
            }
          ],
          "quote": "副業の作業時間は、1週間あたり12時間（720分）以内とする。"
        },
        {
          "name": "繁忙期の開始で、1週間あたり8時間以内",
          "all": [
            {
              "name": "開始日が12月1日から翌年1月10日までの間にある",
              "left": "繁忙期の開始",
              "op": "==",
              "right": "あり"
            },
            {
              "name": "1週間あたり8時間以内",
              "left": "週の作業時間",
              "op": "<=",
              "right": 8
            }
          ],
          "quote": "ただし、副業の開始日が毎年12月1日から翌年1月10日までの間にあるときは、前条の上限を1週間あたり8時間（480分）以内とする。"
        }
      ],
      "quote": "副業の作業時間は、1週間あたり12時間（720分）以内とする。"
    },
    {
      "name": "開始日の10日前までに届出した",
      "left": "開始日までの日数",
      "op": ">=",
      "right": 10,
      "quote": "届出は、副業の開始日の10日前までに行う。"
    }
  ],
  "combine": "all",
  "conclusion": {
    "then": "受理",
    "else": "却下"
  }
}
