{
  "format": "rule-card@1",
  "id": "bunsho-haiki-kahi",
  "status": "draft",
  "drafted_by": "claude-fable-5-1",
  "confirmed_by": null,
  "doc": {
    "source": "文書廃棄規程",
    "section": "第2条・第4条・第5条・第6条・第7条・別表",
    "quote": "満了日の翌日以後の文書で、所管部長の承認を得たものは、廃棄できる。"
  },
  "target": "文書の廃棄の可否",
  "match": {
    "conclusions": [
      "廃棄可",
      "保管継続"
    ],
    "keywords": [
      "廃棄"
    ]
  },
  "slots": {
    "基準日": {
      "type": "date",
      "describe": "別表の基準日（会議議事録と経費精算書は作成日、稟議書は決裁日、契約書は契約終了日）"
    },
    "廃棄日": {
      "type": "date",
      "describe": "文書を廃棄する日（廃棄しようとする日）"
    },
    "会議議事録": {
      "type": "bool",
      "absent": "なし",
      "mention": [
        "会議議事録",
        "議事録",
        "会議"
      ],
      "describe": "文書の種類が会議議事録か"
    },
    "経費精算書": {
      "type": "bool",
      "absent": "なし",
      "mention": [
        "経費精算書",
        "経費",
        "精算"
      ],
      "describe": "文書の種類が経費精算書か"
    },
    "稟議書": {
      "type": "bool",
      "absent": "なし",
      "mention": [
        "稟議書",
        "稟議"
      ],
      "describe": "文書の種類が稟議書か"
    },
    "契約書": {
      "type": "bool",
      "absent": "なし",
      "mention": [
        "契約書",
        "契約"
      ],
      "describe": "文書の種類が契約書か"
    },
    "承認": {
      "type": "bool",
      "describe": "所管部長の承認を得たか"
    },
    "台帳登録": {
      "type": "bool",
      "describe": "総務部の文書管理台帳に登録された文書か"
    },
    "複製": {
      "type": "bool",
      "describe": "原本が別に保管されている複製か"
    },
    "法的保全": {
      "type": "bool",
      "describe": "法務部が保全を指定した文書か"
    }
  },
  "conditions": [
    {
      "name": "文書の種類ごとの保存期間の満了日の翌日以後である",
      "any": [
        {
          "name": "会議議事録で、基準日の年度の翌年度4月1日から3年を経過した年の3月31日の翌日以後",
          "all": [
            {
              "name": "文書の種類が会議議事録",
              "left": "会議議事録",
              "op": "==",
              "right": "あり",
              "quote": "| 会議議事録 | 3年 | 作成日 |"
            },
            {
              "name": "廃棄日が基準日の年度の4月1日から48か月後（起算日から3年の満了日の翌日）以後",
              "left": "廃棄日",
              "op": ">=",
              "right": {
                "add_months": [
                  {
                    "year_start": [
                      "基準日",
                      4,
                      1
                    ]
                  },
                  48
                ]
              },
              "quote": "満了日は、起算日から保存年数を経過する年の3月31日とする。"
            }
          ],
          "quote": "保存期間は、別表の基準日が属する年度の翌年度の4月1日から起算する。"
        },
        {
          "name": "経費精算書で、基準日の年度の翌年度4月1日から5年を経過した年の3月31日の翌日以後",
          "all": [
            {
              "name": "文書の種類が経費精算書",
              "left": "経費精算書",
              "op": "==",
              "right": "あり",
              "quote": "| 経費精算書 | 5年 | 作成日 |"
            },
            {
              "name": "廃棄日が基準日の年度の4月1日から72か月後（起算日から5年の満了日の翌日）以後",
              "left": "廃棄日",
              "op": ">=",
              "right": {
                "add_months": [
                  {
                    "year_start": [
                      "基準日",
                      4,
                      1
                    ]
                  },
                  72
                ]
              },
              "quote": "満了日は、起算日から保存年数を経過する年の3月31日とする。"
            }
          ],
          "quote": "保存期間は、別表の基準日が属する年度の翌年度の4月1日から起算する。"
        },
        {
          "name": "稟議書で、基準日の年度の翌年度4月1日から7年を経過した年の3月31日の翌日以後",
          "all": [
            {
              "name": "文書の種類が稟議書",
              "left": "稟議書",
              "op": "==",
              "right": "あり",
              "quote": "| 稟議書 | 7年 | 決裁日 |"
            },
            {
              "name": "廃棄日が基準日の年度の4月1日から96か月後（起算日から7年の満了日の翌日）以後",
              "left": "廃棄日",
              "op": ">=",
              "right": {
                "add_months": [
                  {
                    "year_start": [
                      "基準日",
                      4,
                      1
                    ]
                  },
                  96
                ]
              },
              "quote": "満了日は、起算日から保存年数を経過する年の3月31日とする。"
            }
          ],
          "quote": "保存期間は、別表の基準日が属する年度の翌年度の4月1日から起算する。"
        },
        {
          "name": "契約書で、基準日の年度の翌年度4月1日から10年を経過した年の3月31日の翌日以後",
          "all": [
            {
              "name": "文書の種類が契約書",
              "left": "契約書",
              "op": "==",
              "right": "あり",
              "quote": "| 契約書 | 10年 | 契約終了日 |"
            },
            {
              "name": "廃棄日が基準日の年度の4月1日から132か月後（起算日から10年の満了日の翌日）以後",
              "left": "廃棄日",
              "op": ">=",
              "right": {
                "add_months": [
                  {
                    "year_start": [
                      "基準日",
                      4,
                      1
                    ]
                  },
                  132
                ]
              },
              "quote": "満了日は、起算日から保存年数を経過する年の3月31日とする。"
            }
          ],
          "quote": "保存期間は、別表の基準日が属する年度の翌年度の4月1日から起算する。"
        }
      ],
      "quote": "満了日の翌日以後の文書で、所管部長の承認を得たものは、廃棄できる。"
    },
    {
      "name": "所管部長の承認を得た",
      "left": "承認",
      "op": "==",
      "right": "あり",
      "unless_mentioned": true,
      "mention": [
        "承認",
        "部長",
        "許可",
        "了承"
      ],
      "quote": "満了日の翌日以後の文書で、所管部長の承認を得たものは、廃棄できる。"
    }
  ],
  "combine": "all",
  "exceptions": [
    {
      "name": "法務部が保全を指定した文書は、複製を含め、指定が解除されるまで廃棄してはならない",
      "left": "法的保全",
      "op": "==",
      "right": "あり",
      "conclusion": "保管継続",
      "unless_mentioned": false,
      "mention": [
        "保全",
        "法務部",
        "法務",
        "訴訟"
      ],
      "quote": "法務部が保全を指定した文書は、複製を含め、前2条にかかわらず、指定が解除されるまで廃棄してはならない。"
    },
    {
      "name": "台帳に登録されていない文書は、登録が済むまで廃棄してはならない",
      "left": "台帳登録",
      "op": "==",
      "right": "なし",
      "conclusion": "保管継続",
      "unless_mentioned": false,
      "mention": [
        "台帳",
        "登録",
        "未登録"
      ],
      "quote": "台帳に登録されていない文書は、登録が済むまで廃棄してはならない。"
    },
    {
      "name": "原本が別に保管されている複製は、保存期間及び承認にかかわらず廃棄できる",
      "left": "複製",
      "op": "==",
      "right": "あり",
      "conclusion": "廃棄可",
      "unless_mentioned": false,
      "mention": [
        "複製",
        "コピー",
        "写し",
        "原本"
      ],
      "quote": "原本が別に保管されている複製は、保存期間及び前条の承認にかかわらず廃棄できる。"
    }
  ],
  "conclusion": {
    "then": "廃棄可",
    "else": "保管継続"
  }
}
