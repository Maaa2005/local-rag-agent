{
  "format": "rule-card@1",
  "id": "okugai-sagyo-chushi",
  "status": "draft",
  "drafted_by": "claude-fable-5-1",
  "confirmed_by": null,
  "doc": {
    "source": "屋外作業中止規程",
    "section": "第2条・第3条・第4条・第5条",
    "quote": "次の表のいずれかに当たるときは、作業を中止する。"
  },
  "target": "強風・高温のときの屋外作業の中止",
  "match": {
    "conclusions": [
      "中止",
      "続行"
    ],
    "keywords": [
      "屋外作業",
      "作業中止",
      "現場作業"
    ]
  },
  "slots": {
    "風速": {
      "type": "number",
      "unit": "m/s",
      "describe": "風速（10分間の平均値。瞬間風速は用いない）"
    },
    "時速の風速": {
      "type": "number",
      "unit": "km/h",
      "describe": "時速で測った風速"
    },
    "暑さ指数": {
      "type": "number",
      "unit": "",
      "describe": "現場の測定器の暑さ指数の値"
    },
    "作業日": {
      "type": "date",
      "describe": "屋外作業を行う日"
    },
    "連続作業時間": {
      "type": "number",
      "unit": "分",
      "describe": "同じ作業者の連続作業の長さ"
    },
    "作業開始時刻": {
      "type": "time",
      "describe": "連続作業を始めた時刻"
    },
    "作業終了時刻": {
      "type": "time",
      "describe": "連続作業を終える時刻"
    },
    "屋内の作業": {
      "type": "bool",
      "describe": "屋内の作業か"
    },
    "緊急復旧作業": {
      "type": "bool",
      "describe": "電気、ガス又は水道の緊急復旧作業か"
    },
    "安全衛生責任者の承認": {
      "type": "bool",
      "describe": "安全衛生責任者が承認したか"
    }
  },
  "derive": {
    "風速": {
      "div": [
        "時速の風速",
        3.6
      ]
    },
    "連続作業時間": {
      "minutes_between": [
        "作業開始時刻",
        "作業終了時刻"
      ]
    }
  },
  "constraints": [
    {
      "name": "連続作業時間は 0 以上",
      "left": "連続作業時間",
      "op": ">=",
      "right": 0
    }
  ],
  "conditions": [
    {
      "name": "強風: 風速が15 m/s以上",
      "left": "風速",
      "op": ">=",
      "right": 15,
      "unless_mentioned": false,
      "mention": [
        "風速",
        "風",
        "強風",
        "m/s",
        "メートル毎秒"
      ],
      "quote": "| 強風 | 通年 | 風速が15 m/s以上 |"
    },
    {
      "name": "高温: 6月1日から9月30日までで暑さ指数が31以上",
      "all": [
        {
          "name": "作業日が6月1日から9月30日まで",
          "left": {
            "in_md_range": [
              "作業日",
              6,
              1,
              9,
              30
            ]
          },
          "op": "==",
          "right": "あり",
          "quote": "| 高温 | 6月1日から9月30日まで | 暑さ指数が31以上 |"
        },
        {
          "name": "暑さ指数が31以上",
          "left": "暑さ指数",
          "op": ">=",
          "right": 31,
          "quote": "| 高温 | 6月1日から9月30日まで | 暑さ指数が31以上 |"
        }
      ],
      "unless_mentioned": false,
      "mention": [
        "暑さ指数",
        "WBGT",
        "高温",
        "暑"
      ],
      "quote": "| 高温 | 6月1日から9月30日まで | 暑さ指数が31以上 |"
    },
    {
      "name": "連続作業: 6月1日から9月30日までで暑さ指数が28以上31未満、連続作業が120分を超える",
      "all": [
        {
          "name": "作業日が6月1日から9月30日まで",
          "left": {
            "in_md_range": [
              "作業日",
              6,
              1,
              9,
              30
            ]
          },
          "op": "==",
          "right": "あり",
          "quote": "| 連続作業 | 6月1日から9月30日まで | 暑さ指数が28以上31未満で、同じ作業者の連続作業が120分を超える |"
        },
        {
          "name": "暑さ指数が28以上",
          "left": "暑さ指数",
          "op": ">=",
          "right": 28,
          "quote": "| 連続作業 | 6月1日から9月30日まで | 暑さ指数が28以上31未満で、同じ作業者の連続作業が120分を超える |"
        },
        {
          "name": "暑さ指数が31未満",
          "left": "暑さ指数",
          "op": "<",
          "right": 31,
          "quote": "| 連続作業 | 6月1日から9月30日まで | 暑さ指数が28以上31未満で、同じ作業者の連続作業が120分を超える |"
        },
        {
          "name": "連続作業が120分を超える",
          "left": "連続作業時間",
          "op": ">",
          "right": 120,
          "quote": "| 連続作業 | 6月1日から9月30日まで | 暑さ指数が28以上31未満で、同じ作業者の連続作業が120分を超える |"
        }
      ],
      "unless_mentioned": false,
      "mention": [
        "暑さ指数",
        "WBGT",
        "連続作業",
        "連続",
        "休憩"
      ],
      "quote": "| 連続作業 | 6月1日から9月30日まで | 暑さ指数が28以上31未満で、同じ作業者の連続作業が120分を超える |"
    }
  ],
  "combine": "any",
  "exceptions": [
    {
      "name": "屋内の作業は中止の対象とせず続行する",
      "left": "屋内の作業",
      "op": "==",
      "right": "あり",
      "conclusion": "続行",
      "unless_mentioned": false,
      "mention": [
        "屋内",
        "室内",
        "建物の中",
        "工場内",
        "倉庫内"
      ],
      "quote": "屋内の作業は、この規程による中止の対象とせず、続行する。"
    },
    {
      "name": "安全衛生責任者が承認した電気・ガス・水道の緊急復旧作業は続行する",
      "all": [
        {
          "name": "電気、ガス又は水道の緊急復旧作業である",
          "left": "緊急復旧作業",
          "op": "==",
          "right": "あり"
        },
        {
          "name": "安全衛生責任者が承認した",
          "left": "安全衛生責任者の承認",
          "op": "==",
          "right": "あり"
        }
      ],
      "conclusion": "続行",
      "if_unknown": "hold",
      "unless_mentioned": false,
      "mention": [
        "緊急復旧",
        "復旧",
        "電気",
        "ガス",
        "水道",
        "安全衛生責任者"
      ],
      "quote": "電気、ガス又は水道の緊急復旧作業で、安全衛生責任者が承認したものは、第3条にかかわらず続行する。"
    }
  ],
  "conclusion": {
    "then": "中止",
    "else": "続行"
  }
}
