{
  "format": "rule-card@1",
  "id": "shain-kashitsuke-kahi",
  "status": "draft",
  "drafted_by": "claude-fable-5-1",
  "confirmed_by": null,
  "doc": {
    "source": "社員貸付金規程",
    "section": "第2条・第3条・第4条・第5条・第6条・第7条",
    "quote": "申込額が貸付可能額以下のときは貸し付ける。"
  },
  "target": "社員貸付金の貸付の可否",
  "match": {
    "conclusions": [
      "貸付",
      "謝絶"
    ],
    "keywords": [
      "貸付",
      "貸付金",
      "生活資金"
    ]
  },
  "slots": {
    "申込額": {
      "type": "number",
      "unit": "円",
      "describe": "貸付金の申込額"
    },
    "前年の年収": {
      "type": "number",
      "unit": "円",
      "describe": "前年の年収"
    },
    "残高あり": {
      "type": "bool",
      "absent": "なし",
      "mention": [
        "残高",
        "既に借り",
        "借入中",
        "返済中",
        "借りている"
      ],
      "describe": "既に借りているこの貸付金の残高があるか"
    },
    "残高": {
      "type": "number",
      "unit": "円",
      "describe": "既に借りているこの貸付金の残高"
    },
    "自宅が半壊以上の被害": {
      "type": "bool",
      "absent": "なし",
      "mention": [
        "災害",
        "罹災",
        "半壊",
        "全壊",
        "被災",
        "地震"
      ],
      "describe": "自然災害により自宅が半壊以上の被害を受けたか"
    },
    "罹災証明書の交付": {
      "type": "bool",
      "absent": "なし",
      "mention": [
        "罹災証明",
        "証明書",
        "災害",
        "半壊",
        "全壊",
        "被災"
      ],
      "describe": "罹災証明書の交付を受けたか"
    },
    "返済回数": {
      "type": "number",
      "unit": "回",
      "describe": "返済回数（返済は毎月1回）"
    },
    "返済期間": {
      "type": "number",
      "unit": "か月",
      "describe": "返済の期間（返済は毎月1回なので月数が返済回数になる）"
    },
    "勤続月数": {
      "type": "number",
      "unit": "か月",
      "describe": "勤続の期間"
    },
    "入社日": {
      "type": "date",
      "describe": "入社した日"
    },
    "申込日": {
      "type": "date",
      "describe": "貸付金を申し込む日"
    },
    "正社員": {
      "type": "bool",
      "describe": "正社員か"
    }
  },
  "derive": {
    "返済回数": "返済期間",
    "勤続月数": {
      "months_between": [
        "入社日",
        "申込日"
      ]
    }
  },
  "constraints": [
    {
      "name": "前年の年収は 0 より大きい",
      "left": "前年の年収",
      "op": ">",
      "right": 0
    },
    {
      "name": "残高は 0 以上",
      "left": "残高",
      "op": ">=",
      "right": 0
    },
    {
      "name": "申込額は 0 より大きい",
      "left": "申込額",
      "op": ">",
      "right": 0
    }
  ],
  "conditions": [
    {
      "name": "勤続3年以上",
      "left": "勤続月数",
      "op": ">=",
      "right": 36,
      "unless_mentioned": true,
      "mention": [
        "勤続",
        "入社",
        "年目",
        "在籍"
      ],
      "quote": "勤続3年以上の正社員は、貸付金を申し込むことができる。"
    },
    {
      "name": "正社員である",
      "left": "正社員",
      "op": "==",
      "right": "あり",
      "unless_mentioned": true,
      "mention": [
        "正社員",
        "契約社員",
        "パート",
        "アルバイト",
        "嘱託",
        "派遣"
      ],
      "quote": "勤続3年以上の正社員は、貸付金を申し込むことができる。"
    },
    {
      "name": "申込額が貸付可能額以下",
      "any": [
        {
          "name": "災害の特例でなく残高がないとき、申込額が限度額（年収の20%と300万円の小さい方）以下",
          "all": [
            {
              "name": "自宅が半壊以上の被害を受けていない",
              "left": "自宅が半壊以上の被害",
              "op": "==",
              "right": "なし"
            },
            {
              "name": "残高がない",
              "left": "残高あり",
              "op": "==",
              "right": "なし"
            },
            {
              "name": "申込額が限度額以下",
              "left": "申込額",
              "op": "<=",
              "right": {
                "min": [
                  {
                    "mul": [
                      "前年の年収",
                      0.2
                    ]
                  },
                  3000000
                ]
              },
              "quote": "限度額は、次のAとBのうち小さい方とする。"
            }
          ],
          "quote": "残高がないときは、限度額を貸付可能額とする。"
        },
        {
          "name": "災害の特例でなく残高があるとき、申込額が限度額から残高を差し引いた額以下",
          "all": [
            {
              "name": "自宅が半壊以上の被害を受けていない",
              "left": "自宅が半壊以上の被害",
              "op": "==",
              "right": "なし"
            },
            {
              "name": "残高がある",
              "left": "残高あり",
              "op": "==",
              "right": "あり"
            },
            {
              "name": "申込額が限度額から残高を差し引いた額以下",
              "left": "申込額",
              "op": "<=",
              "right": {
                "sub": [
                  {
                    "min": [
                      {
                        "mul": [
                          "前年の年収",
                          0.2
                        ]
                      },
                      3000000
                    ]
                  },
                  "残高"
                ]
              },
              "quote": "限度額は、次のAとBのうち小さい方とする。"
            }
          ],
          "quote": "既に借りているこの貸付金の残高があるときは、限度額から残高を差し引いた額を貸付可能額とする。"
        },
        {
          "name": "災害の特例で残高がないとき、申込額が500万円以下",
          "all": [
            {
              "name": "自宅が半壊以上の被害を受けた",
              "left": "自宅が半壊以上の被害",
              "op": "==",
              "right": "あり"
            },
            {
              "name": "罹災証明書の交付を受けた",
              "left": "罹災証明書の交付",
              "op": "==",
              "right": "あり"
            },
            {
              "name": "残高がない",
              "left": "残高あり",
              "op": "==",
              "right": "なし"
            },
            {
              "name": "申込額が500万円以下",
              "left": "申込額",
              "op": "<=",
              "right": 5000000
            }
          ],
          "quote": "自然災害により自宅が半壊以上の被害を受け、罹災証明書の交付を受けた者については、第3条にかかわらず、限度額を500万円とする。"
        },
        {
          "name": "災害の特例で残高があるとき、申込額が500万円から残高を差し引いた額以下",
          "all": [
            {
              "name": "自宅が半壊以上の被害を受けた",
              "left": "自宅が半壊以上の被害",
              "op": "==",
              "right": "あり"
            },
            {
              "name": "罹災証明書の交付を受けた",
              "left": "罹災証明書の交付",
              "op": "==",
              "right": "あり"
            },
            {
              "name": "残高がある",
              "left": "残高あり",
              "op": "==",
              "right": "あり"
            },
            {
              "name": "申込額が500万円から残高を差し引いた額以下",
              "left": "申込額",
              "op": "<=",
              "right": {
                "sub": [
                  5000000,
                  "残高"
                ]
              }
            }
          ],
          "quote": "自然災害により自宅が半壊以上の被害を受け、罹災証明書の交付を受けた者については、第3条にかかわらず、限度額を500万円とする。"
        }
      ],
      "quote": "申込額が貸付可能額以下のときは貸し付ける。"
    },
    {
      "name": "返済回数が60回以内",
      "left": "返済回数",
      "op": "<=",
      "right": 60,
      "unless_mentioned": true,
      "mention": [
        "返済",
        "回払い",
        "分割",
        "回で"
      ],
      "quote": "返済は毎月1回とし、返済回数は60回以内とする。"
    }
  ],
  "combine": "all",
  "conclusion": {
    "then": "貸付",
    "else": "謝絶"
  }
}
