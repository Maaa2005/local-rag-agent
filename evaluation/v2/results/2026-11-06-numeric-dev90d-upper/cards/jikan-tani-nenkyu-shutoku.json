{
  "format": "rule-card@1",
  "id": "jikan-tani-nenkyu-shutoku",
  "status": "draft",
  "drafted_by": "claude-fable-5-1",
  "confirmed_by": null,
  "doc": {
    "source": "時間単位年休規程",
    "section": "第2条・第3条・第4条・第5条・第6条",
    "quote": "入社日から6か月を経過した社員は、時間単位の年休を取得できる。"
  },
  "target": "時間単位の年休の取得",
  "match": {
    "conclusions": [
      "取れる",
      "取れない"
    ],
    "keywords": [
      "時間単位"
    ]
  },
  "slots": {
    "入社日": {
      "type": "date",
      "describe": "入社日"
    },
    "取得日": {
      "type": "date",
      "describe": "時間単位の年休を取得する日（取得日）"
    },
    "勤続月数": {
      "type": "number",
      "unit": "か月",
      "describe": "入社日から取得日までに経過した月数"
    },
    "今回取得時間": {
      "type": "number",
      "unit": "時間",
      "describe": "今回取得する時間単位の年休の時間数（今回分）"
    },
    "当年度既取得時間": {
      "type": "number",
      "unit": "時間",
      "describe": "1年度（4月1日から翌年3月31日まで）に既に取得した時間単位の年休の合計時間。前年度に取得した時間は入れない"
    },
    "当年度時間取得分": {
      "type": "number",
      "unit": "時間",
      "describe": "当年度に時間で数えて取得した分の時間数"
    },
    "当年度日数取得分": {
      "type": "number",
      "unit": "日",
      "describe": "当年度に日数で数えて取得した分の日数"
    },
    "所定労働時間": {
      "type": "number",
      "unit": "時間",
      "describe": "1日の所定労働時間"
    },
    "申請日": {
      "type": "date",
      "describe": "勤怠システムで申請した日"
    },
    "申請時刻": {
      "type": "time",
      "describe": "勤怠システムで申請した時刻"
    },
    "申請から取得日までの日数": {
      "type": "number",
      "unit": "日",
      "describe": "申請した日から取得日までの日数（前日の申請なら 1）"
    },
    "急病": {
      "type": "bool",
      "absent": "なし",
      "mention": [
        "急病",
        "病気",
        "体調",
        "発熱",
        "具合"
      ],
      "describe": "本人又は同居の家族の急病か"
    },
    "連絡時刻": {
      "type": "time",
      "describe": "上長へ連絡した時刻"
    },
    "始業時刻": {
      "type": "time",
      "describe": "当日の始業時刻"
    }
  },
  "derive": {
    "勤続月数": {
      "months_between": [
        "入社日",
        "取得日"
      ]
    },
    "当年度既取得時間": {
      "add": [
        "当年度時間取得分",
        {
          "mul": [
            "当年度日数取得分",
            "所定労働時間"
          ]
        }
      ]
    },
    "申請から取得日までの日数": {
      "sub": [
        "取得日",
        "申請日"
      ]
    }
  },
  "conditions": [
    {
      "name": "入社日から6か月を経過した",
      "left": "勤続月数",
      "op": ">=",
      "right": 6,
      "unless_mentioned": true,
      "mention": [
        "入社",
        "勤続",
        "試用",
        "経過",
        "在籍"
      ],
      "quote": "入社日から6か月を経過した社員は、時間単位の年休を取得できる。"
    },
    {
      "name": "取得の単位が1時間以上",
      "left": "今回取得時間",
      "op": ">=",
      "right": 1,
      "unless_mentioned": true,
      "mention": [
        "分",
        "満たない",
        "未満"
      ],
      "quote": "1時間に満たない単位では取得できない。"
    },
    {
      "name": "1年度に取得する時間の合計が今回分を含めて40時間以内",
      "left": {
        "add": [
          "当年度既取得時間",
          "今回取得時間"
        ]
      },
      "op": "<=",
      "right": 40,
      "quote": "1年度（4月1日から翌年3月31日まで）に取得する時間の合計は、今回分を含めて40時間以内とする。"
    },
    {
      "name": "1日の所定労働時間が8時間に満たない社員は合計が所定労働時間に5を乗じた時間以内",
      "any": [
        {
          "name": "1日の所定労働時間が8時間以上",
          "left": "所定労働時間",
          "op": ">=",
          "right": 8
        },
        {
          "name": "合計が1日の所定労働時間に5を乗じた時間以内",
          "left": {
            "add": [
              "当年度既取得時間",
              "今回取得時間"
            ]
          },
          "op": "<=",
          "right": {
            "mul": [
              "所定労働時間",
              5
            ]
          }
        }
      ],
      "unless_mentioned": true,
      "mention": [
        "所定労働時間",
        "所定",
        "短時間",
        "時短",
        "パート",
        "勤務時間"
      ],
      "quote": "1日の所定労働時間が8時間に満たない社員については、前項の「40時間」を「1日の所定労働時間に5を乗じた時間」と読み替える。"
    },
    {
      "name": "取得日の前日の17時までに申請した、または急病で当日の始業時刻までに上長へ連絡した",
      "any": [
        {
          "name": "取得日の前日の17時までに勤怠システムで申請した",
          "any": [
            {
              "name": "取得日の前日より前に申請した",
              "left": "申請から取得日までの日数",
              "op": ">",
              "right": 1
            },
            {
              "name": "取得日の前日の17時までに申請した",
              "all": [
                {
                  "name": "取得日の前日に申請した",
                  "left": "申請から取得日までの日数",
                  "op": "==",
                  "right": 1
                },
                {
                  "name": "申請時刻が17時まで",
                  "left": "申請時刻",
                  "op": "<=",
                  "right": {
                    "time": "17:00"
                  }
                }
              ]
            }
          ],
          "quote": "取得日の前日の17時までに勤怠システムで申請する。"
        },
        {
          "name": "急病で当日の始業時刻までに上長へ連絡した",
          "all": [
            {
              "name": "本人又は同居の家族の急病",
              "left": "急病",
              "op": "==",
              "right": "あり"
            },
            {
              "name": "当日の始業時刻までに上長へ連絡した",
              "left": "連絡時刻",
              "op": "<=",
              "right": "始業時刻"
            }
          ],
          "quote": "本人又は同居の家族の急病のときは、当日の始業時刻までに上長へ連絡すれば、前条の申請に代えることができる。"
        }
      ],
      "unless_mentioned": true,
      "mention": [
        "申請",
        "前日",
        "17時",
        "急病",
        "連絡",
        "勤怠"
      ],
      "quote": "取得日の前日の17時までに勤怠システムで申請する。"
    }
  ],
  "combine": "all",
  "conclusion": {
    "then": "取れる",
    "else": "取れない"
  }
}
