{
  "format": "rule-card@1",
  "id": "einen-kinzoku-kinenhin",
  "status": "draft",
  "drafted_by": "claude-fable-5-1",
  "confirmed_by": null,
  "doc": {
    "source": "永年勤続表彰規程",
    "section": "第4条・第5条・第3条・第2条・附則",
    "quote": "基準日に正社員として在籍し、勤続月数が120か月以上で、この記念品をまだ受けていない者に、記念品を贈呈する。"
  },
  "target": "永年勤続の記念品の贈呈",
  "match": {
    "conclusions": [
      "贈呈",
      "対象外"
    ],
    "keywords": [
      "永年勤続",
      "記念品"
    ]
  },
  "slots": {
    "基準日": {
      "type": "date",
      "describe": "基準日（毎年10月1日）"
    },
    "入社日": {
      "type": "date",
      "describe": "入社日"
    },
    "勤続月数": {
      "type": "number",
      "unit": "か月",
      "describe": "入社日から基準日までの勤続月数"
    },
    "正社員": {
      "type": "bool",
      "describe": "基準日に正社員として在籍しているか"
    },
    "記念品受領済み": {
      "type": "bool",
      "describe": "この記念品をすでに受けたか"
    },
    "私傷病休職月数": {
      "type": "number",
      "unit": "か月",
      "describe": "私傷病による休職の月数（育児休業の期間、出向の期間、労働基準監督署が業務災害と認定した負傷又は疾病による休職の期間は含めない）"
    },
    "旧東西物産からの移籍": {
      "type": "bool",
      "absent": "なし",
      "mention": [
        "東西物産",
        "合併",
        "移籍"
      ],
      "describe": "2018年4月1日の合併により旧東西物産から移籍した社員か"
    },
    "旧東西物産勤続月数": {
      "type": "number",
      "unit": "か月",
      "describe": "旧東西物産での勤続月数"
    },
    "出勤停止以上の懲戒処分": {
      "type": "bool",
      "describe": "出勤停止以上の懲戒処分を受けたか（戒告及びけん責は当たらない）"
    },
    "懲戒処分日": {
      "type": "date",
      "describe": "出勤停止以上の懲戒処分を受けた日"
    },
    "懲戒処分からの月数": {
      "type": "number",
      "unit": "か月",
      "describe": "出勤停止以上の懲戒処分を受けてから基準日までの月数"
    }
  },
  "derive": {
    "勤続月数": {
      "months_between": [
        "入社日",
        {
          "year_start": [
            "基準日",
            10,
            1
          ]
        }
      ]
    },
    "懲戒処分からの月数": {
      "months_between": [
        "懲戒処分日",
        {
          "year_start": [
            "基準日",
            10,
            1
          ]
        }
      ]
    }
  },
  "constraints": [
    {
      "name": "勤続月数は 0 以上",
      "left": "勤続月数",
      "op": ">=",
      "right": 0
    }
  ],
  "conditions": [
    {
      "name": "基準日に正社員として在籍している",
      "left": "正社員",
      "op": "==",
      "right": "あり",
      "unless_mentioned": true,
      "mention": [
        "正社員",
        "契約社員",
        "パート",
        "アルバイト",
        "嘱託",
        "退職"
      ],
      "quote": "基準日に正社員として在籍し、勤続月数が120か月以上で、この記念品をまだ受けていない者に、記念品を贈呈する。"
    },
    {
      "name": "勤続月数が120か月以上",
      "any": [
        {
          "name": "旧東西物産からの移籍でなく、入社日から基準日までの勤続月数が120か月以上",
          "all": [
            {
              "name": "旧東西物産からの移籍ではない",
              "left": "旧東西物産からの移籍",
              "op": "==",
              "right": "なし"
            },
            {
              "name": "勤続月数が120か月以上",
              "left": "勤続月数",
              "op": ">=",
              "right": 120
            }
          ]
        },
        {
          "name": "旧東西物産からの移籍で、2018年4月1日から基準日までの月数に旧東西物産での勤続月数の2分の1を加えて120か月以上",
          "all": [
            {
              "name": "旧東西物産からの移籍である",
              "left": "旧東西物産からの移籍",
              "op": "==",
              "right": "あり"
            },
            {
              "name": "2018年4月1日からの勤続月数と旧東西物産での勤続月数の2分の1の和が120か月以上",
              "left": {
                "add": [
                  {
                    "months_between": [
                      {
                        "date": "2018-04-01"
                      },
                      {
                        "year_start": [
                          "基準日",
                          10,
                          1
                        ]
                      }
                    ]
                  },
                  {
                    "div": [
                      "旧東西物産勤続月数",
                      2
                    ]
                  }
                ]
              },
              "op": ">=",
              "right": 120,
              "quote": "2018年4月1日の合併により旧東西物産から移籍した社員は、入社日を2018年4月1日とし、旧東西物産での勤続月数の2分の1（1か月未満切り捨て）を勤続月数に加える。"
            }
          ]
        }
      ],
      "quote": "基準日に正社員として在籍し、勤続月数が120か月以上で、この記念品をまだ受けていない者に、記念品を贈呈する。"
    }
  ],
  "combine": "all",
  "exceptions": [
    {
      "name": "この記念品をすでに受けている",
      "left": "記念品受領済み",
      "op": "==",
      "right": "あり",
      "conclusion": "対象外",
      "unless_mentioned": false,
      "mention": [
        "すでに",
        "既に",
        "受け取",
        "もらった",
        "受けた",
        "前回"
      ],
      "quote": "基準日に正社員として在籍し、勤続月数が120か月以上で、この記念品をまだ受けていない者に、記念品を贈呈する。"
    },
    {
      "name": "私傷病による休職の月数を差し引くと勤続月数が120か月未満",
      "any": [
        {
          "name": "旧東西物産からの移籍でなく、休職の月数を差し引いた勤続月数が120か月未満",
          "all": [
            {
              "name": "旧東西物産からの移籍ではない",
              "left": "旧東西物産からの移籍",
              "op": "==",
              "right": "なし"
            },
            {
              "name": "勤続月数から私傷病休職月数を引くと120か月未満",
              "left": {
                "sub": [
                  "勤続月数",
                  "私傷病休職月数"
                ]
              },
              "op": "<",
              "right": 120
            }
          ]
        },
        {
          "name": "旧東西物産からの移籍で、休職の月数を差し引いた勤続月数が120か月未満",
          "all": [
            {
              "name": "旧東西物産からの移籍である",
              "left": "旧東西物産からの移籍",
              "op": "==",
              "right": "あり"
            },
            {
              "name": "2018年4月1日からの勤続月数と旧東西物産での勤続月数の2分の1の和から私傷病休職月数を引くと120か月未満",
              "left": {
                "sub": [
                  {
                    "add": [
                      {
                        "months_between": [
                          {
                            "date": "2018-04-01"
                          },
                          {
                            "year_start": [
                              "基準日",
                              10,
                              1
                            ]
                          }
                        ]
                      },
                      {
                        "div": [
                          "旧東西物産勤続月数",
                          2
                        ]
                      }
                    ]
                  },
                  "私傷病休職月数"
                ]
              },
              "op": "<",
              "right": 120
            }
          ]
        }
      ],
      "conclusion": "対象外",
      "unless_mentioned": false,
      "mention": [
        "休職",
        "私傷病",
        "病気",
        "傷病",
        "けが"
      ],
      "quote": "私傷病による休職の月数は、勤続月数から差し引く。"
    },
    {
      "name": "基準日前3年以内に出勤停止以上の懲戒処分を受けた",
      "all": [
        {
          "name": "出勤停止以上の懲戒処分を受けた",
          "left": "出勤停止以上の懲戒処分",
          "op": "==",
          "right": "あり"
        },
        {
          "name": "懲戒処分から基準日までが36か月以内",
          "left": "懲戒処分からの月数",
          "op": "<=",
          "right": 36
        }
      ],
      "conclusion": "対象外",
      "unless_mentioned": false,
      "mention": [
        "懲戒",
        "処分",
        "出勤停止",
        "降格",
        "解雇",
        "減給"
      ],
      "quote": "基準日前3年以内に出勤停止以上の懲戒処分を受けた者は、前条にかかわらず対象外とする。"
    }
  ],
  "conclusion": {
    "then": "贈呈",
    "else": "対象外"
  }
}
