{
  "format": "rule-card@1",
  "id": "shinya-kitaku-taxi-futan",
  "status": "draft",
  "drafted_by": "claude-fable-5-1",
  "confirmed_by": null,
  "doc": {
    "source": "深夜帰宅タクシー利用規程",
    "section": "第2条・第3条・第4条・第5条",
    "quote": "退社時刻が22時30分から翌日5時までの間（どちらの時刻も含む）であるとき、タクシー代を会社の負担とする。"
  },
  "target": "深夜帰宅のタクシー代の負担",
  "match": {
    "conclusions": [
      "会社負担",
      "個人負担"
    ],
    "keywords": [
      "タクシー"
    ]
  },
  "slots": {
    "退社時刻": {
      "type": "time",
      "describe": "退社時刻"
    },
    "領収書の金額": {
      "type": "number",
      "unit": "円",
      "describe": "領収書1枚の金額"
    },
    "承認を受けた時間外勤務": {
      "type": "bool",
      "describe": "所属長の承認を受けた時間外勤務か"
    },
    "妊娠中": {
      "type": "bool",
      "describe": "妊娠中の社員本人か"
    }
  },
  "conditions": [
    {
      "name": "所属長の承認を受けた時間外勤務のあとの帰宅である",
      "left": "承認を受けた時間外勤務",
      "op": "==",
      "right": "あり",
      "unless_mentioned": true,
      "mention": [
        "承認",
        "許可",
        "無断",
        "勝手に",
        "自己判断"
      ],
      "quote": "この規程は、所属長の承認を受けた時間外勤務のあとに帰宅する社員に適用する。"
    },
    {
      "name": "退社時刻が22時30分（妊娠中は21時）から翌日5時までの間である",
      "any": [
        {
          "name": "妊娠中でなく、退社時刻が22時30分から翌日5時までの間",
          "all": [
            {
              "name": "妊娠中の社員本人でない",
              "left": "妊娠中",
              "op": "==",
              "right": "なし",
              "quote": "ただし、妊娠中の社員本人については、第3条の「22時30分」を「21時」と読み替える。"
            },
            {
              "name": "退社時刻が22時30分から翌日5時までの間（どちらも含む）",
              "any": [
                {
                  "name": "退社時刻が22時30分以降",
                  "left": "退社時刻",
                  "op": ">=",
                  "right": {
                    "time": "22:30"
                  }
                },
                {
                  "name": "退社時刻が翌日5時まで",
                  "left": "退社時刻",
                  "op": "<=",
                  "right": {
                    "time": "05:00"
                  }
                }
              ],
              "quote": "退社時刻が22時30分から翌日5時までの間（どちらの時刻も含む）であるとき、タクシー代を会社の負担とする。"
            }
          ]
        },
        {
          "name": "妊娠中で、退社時刻が21時から翌日5時までの間",
          "all": [
            {
              "name": "妊娠中の社員本人である",
              "left": "妊娠中",
              "op": "==",
              "right": "あり",
              "quote": "ただし、妊娠中の社員本人については、第3条の「22時30分」を「21時」と読み替える。"
            },
            {
              "name": "退社時刻が21時から翌日5時までの間（どちらも含む）",
              "any": [
                {
                  "name": "退社時刻が21時以降",
                  "left": "退社時刻",
                  "op": ">=",
                  "right": {
                    "time": "21:00"
                  }
                },
                {
                  "name": "退社時刻が翌日5時まで",
                  "left": "退社時刻",
                  "op": "<=",
                  "right": {
                    "time": "05:00"
                  }
                }
              ],
              "quote": "ただし、妊娠中の社員本人については、第3条の「22時30分」を「21時」と読み替える。"
            }
          ]
        }
      ],
      "quote": "退社時刻が22時30分から翌日5時までの間（どちらの時刻も含む）であるとき、タクシー代を会社の負担とする。"
    },
    {
      "name": "領収書1枚の金額が15,000円以下",
      "left": "領収書の金額",
      "op": "<=",
      "right": 15000,
      "quote": "領収書1枚の金額が15,000円以下のときに限り、前条を適用する。"
    }
  ],
  "combine": "all",
  "conclusion": {
    "then": "会社負担",
    "else": "個人負担"
  }
}
