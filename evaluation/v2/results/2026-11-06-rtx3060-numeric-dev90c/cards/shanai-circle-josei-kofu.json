{
  "format": "rule-card@1",
  "id": "shanai-circle-josei-kofu",
  "status": "draft",
  "drafted_by": "claude-fable-5-1",
  "confirmed_by": null,
  "doc": {
    "source": "社内サークル助成規程",
    "section": "第2条・第3条・第4条・第5条",
    "quote": "1回の活動について、活動時間が90分以上（1時間30分以上）で、かつ参加した社員が5人以上のときに助成する。"
  },
  "target": "社内サークルの活動費の助成",
  "match": {
    "conclusions": [
      "交付",
      "対象外"
    ],
    "keywords": [
      "サークル"
    ]
  },
  "slots": {
    "登録済み": {
      "type": "bool",
      "describe": "総務部に登録済みのサークルか"
    },
    "開始時刻": {
      "type": "time",
      "describe": "活動の開始時刻"
    },
    "終了時刻": {
      "type": "time",
      "describe": "活動の終了時刻"
    },
    "活動時間": {
      "type": "number",
      "unit": "分",
      "describe": "1回の活動の活動時間（1時間30分は90分）"
    },
    "参加者数": {
      "type": "number",
      "unit": "人",
      "describe": "活動に参加した人数の合計（社員でない参加者を含む）"
    },
    "社員でない参加者数": {
      "type": "number",
      "unit": "人",
      "describe": "参加した人のうち社員でない参加者の人数"
    },
    "参加社員数": {
      "type": "number",
      "unit": "人",
      "describe": "参加した社員の人数（社員でない参加者は人数に数えない）"
    },
    "実費": {
      "type": "number",
      "unit": "円",
      "describe": "その回の活動の実費"
    },
    "新入社員歓迎": {
      "type": "bool",
      "describe": "新入社員歓迎の活動か"
    },
    "活動日": {
      "type": "date",
      "describe": "活動を行う日"
    }
  },
  "derive": {
    "活動時間": {
      "minutes_between": [
        "開始時刻",
        "終了時刻"
      ]
    },
    "参加社員数": {
      "sub": [
        "参加者数",
        "社員でない参加者数"
      ]
    }
  },
  "constraints": [
    {
      "name": "参加社員数は参加者数以下",
      "left": "参加社員数",
      "op": "<=",
      "right": "参加者数"
    },
    {
      "name": "実費は 0 以上",
      "left": "実費",
      "op": ">=",
      "right": 0
    }
  ],
  "conditions": [
    {
      "name": "総務部に登録済みのサークルの活動である",
      "left": "登録済み",
      "op": "==",
      "right": "あり",
      "unless_mentioned": true,
      "mention": [
        "登録",
        "未登録",
        "総務部"
      ],
      "quote": "助成の対象は、総務部に登録済みのサークルの活動に限る。"
    },
    {
      "name": "活動時間が90分以上",
      "left": "活動時間",
      "op": ">=",
      "right": 90,
      "quote": "1回の活動について、活動時間が90分以上（1時間30分以上）で、かつ参加した社員が5人以上のときに助成する。"
    },
    {
      "name": "参加した社員が5人以上（4月の新入社員歓迎の活動は3人以上）",
      "any": [
        {
          "name": "参加した社員が5人以上",
          "left": "参加社員数",
          "op": ">=",
          "right": 5,
          "quote": "1回の活動について、活動時間が90分以上（1時間30分以上）で、かつ参加した社員が5人以上のときに助成する。"
        },
        {
          "name": "4月に行う新入社員歓迎の活動で参加した社員が3人以上",
          "all": [
            {
              "name": "新入社員歓迎の活動である",
              "left": "新入社員歓迎",
              "op": "==",
              "right": "あり",
              "unless_mentioned": false,
              "mention": [
                "新入社員",
                "歓迎",
                "新人"
              ]
            },
            {
              "name": "4月に行う活動である",
              "left": {
                "in_md_range": [
                  "活動日",
                  4,
                  1,
                  4,
                  30
                ]
              },
              "op": "==",
              "right": "あり",
              "unless_mentioned": false,
              "mention": [
                "4月",
                "四月",
                "新入社員",
                "歓迎"
              ]
            },
            {
              "name": "参加した社員が3人以上",
              "left": "参加社員数",
              "op": ">=",
              "right": 3
            }
          ],
          "quote": "ただし、4月に行う新入社員歓迎の活動については、第3条の「5人以上」を「3人以上」と読み替える。"
        }
      ],
      "quote": "1回の活動について、活動時間が90分以上（1時間30分以上）で、かつ参加した社員が5人以上のときに助成する。"
    },
    {
      "name": "実費の50%と参加した社員の人数×1,000円のうち小さい方が3,000円以上",
      "left": {
        "min": [
          {
            "div": [
              "実費",
              2
            ]
          },
          {
            "mul": [
              "参加社員数",
              1000
            ]
          }
        ]
      },
      "op": ">=",
      "right": 3000,
      "quote": "前項により算出した額が3,000円に満たないときは、助成しない。"
    }
  ],
  "combine": "all",
  "conclusion": {
    "then": "交付",
    "else": "対象外"
  }
}
