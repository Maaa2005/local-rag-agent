{
  "format": "rule-card@1",
  "id": "shikaku-jukenryo-josei",
  "status": "draft",
  "drafted_by": "claude-fable-5-1",
  "confirmed_by": null,
  "doc": {
    "source": "資格受験料補助規程",
    "section": "第1条・第2条・第3条・第4条・第5条",
    "quote": "同じ年度（毎年4月1日から翌年3月31日まで）に交付する受験料の合計が、今回の申請分を含めて6万円（60,000円）以内のとき、今回の受験料を交付する。"
  },
  "target": "資格の受験料の助成",
  "match": {
    "conclusions": [
      "助成あり",
      "助成なし"
    ],
    "keywords": [
      "受験料",
      "資格"
    ]
  },
  "slots": {
    "合格": {
      "type": "bool",
      "describe": "試験に合格したか"
    },
    "正社員": {
      "type": "bool",
      "describe": "正社員か"
    },
    "受験料の申請": {
      "type": "bool",
      "describe": "申請する費用が受験料か（教材費や交通費ではなく受験料か）"
    },
    "業務必須資格": {
      "type": "bool",
      "describe": "業務必須資格（第二種電気工事士・危険物取扱者乙種第4類・第二種衛生管理者のいずれか）の受験料か"
    },
    "今回の受験料": {
      "type": "number",
      "unit": "円",
      "describe": "今回申請する試験の受験料"
    },
    "交付済みの受験料の合計": {
      "type": "number",
      "unit": "円",
      "describe": "同じ年度（毎年4月1日から翌年3月31日まで）に既に交付された受験料の合計（今回の申請分を除く。年度で初めての申請なら 0）"
    },
    "年度の受験料の合計": {
      "type": "number",
      "unit": "円",
      "describe": "同じ年度に交付する受験料の合計（今回の申請分を含めて）"
    },
    "合格発表日": {
      "type": "date",
      "describe": "合格発表日"
    },
    "申請日": {
      "type": "date",
      "describe": "申請した日"
    },
    "合格発表日から申請までの日数": {
      "type": "number",
      "unit": "日",
      "describe": "合格発表日の翌日から数えて申請日までの日数（合格発表日の何日後に申請したか）"
    }
  },
  "derive": {
    "年度の受験料の合計": {
      "add": [
        "交付済みの受験料の合計",
        "今回の受験料"
      ]
    },
    "合格発表日から申請までの日数": {
      "sub": [
        "申請日",
        "合格発表日"
      ]
    }
  },
  "constraints": [
    {
      "name": "今回の受験料は 0 以上",
      "left": "今回の受験料",
      "op": ">=",
      "right": 0
    },
    {
      "name": "交付済みの受験料の合計は 0 以上",
      "left": "交付済みの受験料の合計",
      "op": ">=",
      "right": 0
    },
    {
      "name": "合格発表日から申請までの日数は 0 以上",
      "left": "合格発表日から申請までの日数",
      "op": ">=",
      "right": 0
    }
  ],
  "conditions": [
    {
      "name": "試験に合格した",
      "left": "合格",
      "op": "==",
      "right": "あり",
      "unless_mentioned": true,
      "mention": [
        "不合格",
        "落ち",
        "受から",
        "合格でき"
      ],
      "quote": "交付の対象は、試験に合格した正社員に限る。"
    },
    {
      "name": "正社員である",
      "left": "正社員",
      "op": "==",
      "right": "あり",
      "unless_mentioned": true,
      "mention": [
        "正社員",
        "契約社員",
        "パート",
        "アルバイト",
        "派遣",
        "嘱託"
      ],
      "quote": "交付の対象は、試験に合格した正社員に限る。"
    },
    {
      "name": "申請する費用が受験料である",
      "left": "受験料の申請",
      "op": "==",
      "right": "あり",
      "unless_mentioned": true,
      "mention": [
        "教材",
        "テキスト",
        "参考書",
        "交通費",
        "受講料",
        "講座"
      ],
      "quote": "交付の対象は受験料に限り、教材費や交通費は含まない。"
    },
    {
      "name": "同じ年度の受験料の合計が今回の申請分を含めて6万円以内、または業務必須資格の受験料",
      "any": [
        {
          "name": "同じ年度の受験料の合計が今回の申請分を含めて6万円以内",
          "left": "年度の受験料の合計",
          "op": "<=",
          "right": 60000,
          "quote": "同じ年度（毎年4月1日から翌年3月31日まで）に交付する受験料の合計が、今回の申請分を含めて6万円（60,000円）以内のとき、今回の受験料を交付する。"
        },
        {
          "name": "業務必須資格の受験料である",
          "left": "業務必須資格",
          "op": "==",
          "right": "あり",
          "unless_mentioned": false,
          "mention": [
            "電気工事士",
            "危険物",
            "衛生管理者",
            "業務必須",
            "必須資格"
          ],
          "quote": "ただし、次の業務必須資格の受験料には、第3条を適用しない。"
        }
      ],
      "unless_mentioned": true,
      "mention": [
        "既に",
        "すでに",
        "交付済み",
        "これまで",
        "合計",
        "上限",
        "今年度",
        "年度",
        "万円"
      ],
      "quote": "同じ年度（毎年4月1日から翌年3月31日まで）に交付する受験料の合計が、今回の申請分を含めて6万円（60,000円）以内のとき、今回の受験料を交付する。"
    },
    {
      "name": "合格発表日の翌日から数えて90日以内に申請した",
      "left": "合格発表日から申請までの日数",
      "op": "<=",
      "right": 90,
      "unless_mentioned": true,
      "mention": [
        "発表",
        "日後",
        "日以内",
        "日目",
        "か月後",
        "ヶ月後",
        "カ月後",
        "期限",
        "遅れ"
      ],
      "quote": "申請は、合格発表日の翌日から数えて90日以内（90日後の日を含む）に行う。"
    }
  ],
  "combine": "all",
  "conclusion": {
    "then": "助成あり",
    "else": "助成なし"
  }
}
