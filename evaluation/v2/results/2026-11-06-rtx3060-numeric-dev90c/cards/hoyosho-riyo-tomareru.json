{
  "format": "rule-card@1",
  "id": "hoyosho-riyo-tomareru",
  "status": "draft",
  "drafted_by": "claude-fable-5-1",
  "confirmed_by": null,
  "doc": {
    "source": "保養所利用規程",
    "section": "第2条・第3条・第4条・第5条",
    "quote": "1回の利用は4泊以内とする。"
  },
  "target": "保養所の利用",
  "match": {
    "conclusions": [
      "泊まれる",
      "泊まれない"
    ],
    "keywords": [
      "保養所"
    ]
  },
  "slots": {
    "社員本人同行": {
      "type": "bool",
      "describe": "社員本人が同行するか"
    },
    "泊数": {
      "type": "number",
      "unit": "泊",
      "describe": "1回の利用の泊数"
    },
    "チェックイン日": {
      "type": "date",
      "describe": "チェックイン日"
    },
    "申込日": {
      "type": "date",
      "describe": "申込を行った日"
    },
    "申込からチェックインまでの日数": {
      "type": "number",
      "unit": "日",
      "describe": "申込の日からチェックイン日までの日数"
    },
    "表彰日": {
      "type": "date",
      "describe": "永年勤続表彰を受けた日"
    },
    "表彰社員本人同行": {
      "type": "bool",
      "describe": "表彰を受けた社員本人が同行するか"
    }
  },
  "derive": {
    "申込からチェックインまでの日数": {
      "sub": [
        "チェックイン日",
        "申込日"
      ]
    }
  },
  "constraints": [
    {
      "name": "泊数は 1 以上",
      "left": "泊数",
      "op": ">=",
      "right": 1
    }
  ],
  "conditions": [
    {
      "name": "社員本人が同行する",
      "left": "社員本人同行",
      "op": "==",
      "right": "あり",
      "unless_mentioned": true,
      "mention": [
        "家族だけ",
        "家族のみ",
        "知人だけ",
        "知人のみ",
        "本人が同行しない",
        "本人は行かない"
      ],
      "quote": "保養所は、社員本人が同行する場合に利用できる。"
    },
    {
      "name": "1回の利用は4泊以内",
      "left": "泊数",
      "op": "<=",
      "right": 4,
      "quote": "1回の利用は4泊以内とする。"
    },
    {
      "name": "チェックイン日が繁忙期にあたるときは2泊以内（永年勤続表彰の例外あり）",
      "any": [
        {
          "name": "チェックイン日が繁忙期にあたらない",
          "all": [
            {
              "name": "7月20日から8月31日までにあたらない",
              "left": {
                "in_md_range": [
                  "チェックイン日",
                  7,
                  20,
                  8,
                  31
                ]
              },
              "op": "==",
              "right": "なし"
            },
            {
              "name": "12月28日から翌年1月3日までにあたらない",
              "left": {
                "in_md_range": [
                  "チェックイン日",
                  12,
                  28,
                  1,
                  3
                ]
              },
              "op": "==",
              "right": "なし"
            }
          ],
          "quote": "繁忙期かどうかはチェックイン日だけで決める。"
        },
        {
          "name": "2泊以内",
          "left": "泊数",
          "op": "<=",
          "right": 2,
          "quote": "チェックイン日が繁忙期（毎年7月20日から8月31日まで、及び12月28日から翌年1月3日まで。いずれも両端の日を含む）にあたるときは、前項にかかわらず2泊以内とする。"
        },
        {
          "name": "永年勤続表彰を受けた日から1年以内のチェックインで表彰を受けた社員本人が同行する",
          "all": [
            {
              "name": "チェックイン日は表彰日以後",
              "left": "チェックイン日",
              "op": ">=",
              "right": "表彰日"
            },
            {
              "name": "表彰を受けた日から1年以内にチェックインする",
              "left": "チェックイン日",
              "op": "<=",
              "right": {
                "add_months": [
                  "表彰日",
                  12
                ]
              }
            },
            {
              "name": "表彰を受けた社員本人が同行する",
              "left": "表彰社員本人同行",
              "op": "==",
              "right": "あり"
            }
          ],
          "unless_mentioned": false,
          "mention": [
            "永年勤続",
            "勤続表彰",
            "表彰"
          ],
          "quote": "ただし、永年勤続表彰を受けた日から1年以内にチェックインする利用で、表彰を受けた社員本人が同行するものには、第3条第2項を適用しない。"
        }
      ],
      "quote": "チェックイン日が繁忙期（毎年7月20日から8月31日まで、及び12月28日から翌年1月3日まで。いずれも両端の日を含む）にあたるときは、前項にかかわらず2泊以内とする。"
    },
    {
      "name": "申込はチェックイン日の7日前まで",
      "left": "申込からチェックインまでの日数",
      "op": ">=",
      "right": 7,
      "unless_mentioned": true,
      "mention": [
        "申込",
        "申し込",
        "申請",
        "予約"
      ],
      "quote": "申込は、チェックイン日の7日前まで（7日前の日を含む）に行う。"
    }
  ],
  "combine": "all",
  "conclusion": {
    "then": "泊まれる",
    "else": "泊まれない"
  }
}
