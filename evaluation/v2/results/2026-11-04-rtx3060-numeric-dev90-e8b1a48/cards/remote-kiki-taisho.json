    "在宅勤務承認通知": {
      "type": "bool",
      "describe": "人事部が発行する在宅勤務承認通知が届いているかどうか"
    }
  },
  "conditions": [
    {
      "name": "在宅勤務承認通知が届いている",
      "left": "在宅勤務承認通知",
      "op": "==",
      "right": "あり"
    }
  ],
  "combine": "all",
  "conclusion": {
    "then": "対象",
    "else": "対象外"
  }
}
