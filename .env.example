# HuggingFace トークン（プライベートモデル使用時のみ必要）
HF_TOKEN=

# 使用する LLM モデル (vLLM で読み込む HuggingFace モデル名)
# 6GB  VRAM: Qwen/Qwen2.5-3B-Instruct-AWQ  (RTX 3050 など)
# 12GB VRAM: Qwen/Qwen2.5-7B-Instruct-AWQ  (RTX 3060/4070 など)
# 16GB VRAM: Qwen/Qwen2.5-14B-Instruct-AWQ
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ

# 使用する埋め込みモデル (CPU で動作)
EMBED_MODEL=intfloat/multilingual-e5-large

# 埋め込み時に付与する query/passage 用プレフィックス。
# multilingual-e5-large など e5 系モデル用のデフォルト。
# EMBED_QUERY_PREFIX="query: "
# EMBED_PASSAGE_PREFIX="passage: "
#
# 例: Ruri v3 系 (cl-nagoya/ruri-v3-310m 等) へ切り替える場合:
#   EMBED_MODEL=cl-nagoya/ruri-v3-310m
#   EMBED_QUERY_PREFIX="検索クエリ: "
#   EMBED_PASSAGE_PREFIX="検索文書: "
# 注意: embed_model / プレフィックスを変更すると既存ベクトルと非互換になるため、
# 変更後は Qdrant コレクションの全文書を再インデックスする必要がある。

# Cross-Encoder リランキング (検索品質向上)。
# 一次検索 (dense+sparse+RRF) の上位候補を Cross-Encoder で再スコアリングする。
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# リランク対象として一次検索から取得する候補数 (RETRIEVAL_TOP_K より多めに設定)
RERANK_CANDIDATES=30

# JWT 署名キー (本番環境では必ず設定する)
# `openssl rand -hex 32` で生成した値を設定。未設定時は起動ごとに一時キーが
# 自動生成され再起動で全ログインが失効する
SECRET_KEY=

# JWT トークン有効期間 (分)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS 許可オリジン (カンマ区切り or JSON 配列)
# 例: CORS_ORIGINS=http://localhost:3000,https://rag.example.com
CORS_ORIGINS=http://localhost:3000

# 注: 本アプリは社内機密 RAG 専用でローカル LLM (vLLM) に固定。外部送信を伴う
# フロンティア LLM (Anthropic / OpenAI など) は別アプリ frontier-llm-agent に分離済み。
# よって外部 API キーの設定項目は存在しない。
